generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 解析规则表
model ParseRule {
  id            String   @id @default(cuid())
  name          String
  description   String?
  fileTypes     String[] // ["excel", "pdf", "word"]
  ruleJson      Json     // 完整规则JSON
  isActive      Boolean  @default(true)
  isAiGenerated Boolean  @default(false)
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  parseSessions ParseSession[]
}

// 解析会话表
model ParseSession {
  id            String   @id @default(cuid())
  ruleId        String?
  rule          ParseRule? @relation(fields: [ruleId], references: [id])
  fileName      String
  fileType      String
  fileSize      Int
  status        String   @default("pending") // pending/parsing/completed/failed
  totalRows     Int?
  parsedRows    Int?
  errorRows     Int?
  errorMessage  String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  
  orders        Order[]
}

// 运单表
model Order {
  id            String   @id @default(cuid())
  sessionId     String
  session       ParseSession @relation(fields: [sessionId], references: [id])

  // 运单核心字段
  orderNo       String?  // 外部编码（用于去重和聚合）

  // A组：门店模式（只需填收货门店）
  storeName     String?  // 收货门店/机构名称

  // B组：收件人模式（需填以下三个）
  receiverName  String?  // 收货人姓名
  receiverPhone String?  // 收件人联系方式
  receiverAddress String? // 收货人完整地址

  // 发货方信息（可选）
  senderName    String?  // 发货人
  senderPhone   String?
  senderAddress String?

  // 货物信息（SKU）
  itemName      String?  // SKU 物品名称（必填）
  itemCode      String?  // SKU 物品编码（必填）
  itemCategory  String?  // 物品分类
  specification String?  // SKU 规格型号
  quantity      Decimal? @db.Decimal(10, 2) // SKU 发货数量（必填，正数）
  unit          String?

  remark        String?  // 备注

  // 扩展字段（JSON存储灵活字段）
  extraFields   Json?

  // 元信息
  sourceRow     Int?     // 原始行号
  sourceSheet   String?  // 原始Sheet名
  isValid       Boolean  @default(true)
  validationErrors String[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sessionId])
  @@index([orderNo])
}
