      "fileType": "excel",
      "expectedParserType": "table",
      "assertions": {
        "minOrders": 1,
        "requiredFields": ["storeName", "itemName", "quantity"],
        "shouldHaveOrderNo": true
      }
    },
    {
      "id": "sample-02",
